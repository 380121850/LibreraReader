<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dip"
        android:background="@color/tint_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/noteEditTitle"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="12dip"
            android:text="@string/reading_note"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dip">

        <!-- first line: creation time linked to the current book position -->
        <TextView
            android:id="@+id/noteEditMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/noteEditText"
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:layout_weight="1"
            android:layout_marginTop="10dip"
            android:gravity="top"
            android:hint="@string/note_edit_hint"
            android:inputType="textMultiLine"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/noteEditCancel"
                android:layout_width="wrap_content"
                android:layout_height="44dip"
                android:background="@drawable/bg_border_ltgray"
                android:gravity="center"
                android:minWidth="120dip"
                android:paddingLeft="20dip"
                android:paddingRight="20dip"
                android:text="@string/cancel"
                android:textColor="@color/tint_gray"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/noteEditSave"
                android:layout_width="wrap_content"
                android:layout_height="44dip"
                android:layout_marginLeft="12dip"
                android:background="@drawable/bg_border_ltgray"
                android:gravity="center"
                android:minWidth="140dip"
                android:paddingLeft="20dip"
                android:paddingRight="20dip"
                android:text="@string/note_edit_save"
                android:textColor="@color/tint_gray"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
