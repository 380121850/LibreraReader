<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AdMob entries: this manifest overlay is compiled into the ad-enabled
         flavors only (src/admobAds is attached to them in app/build.gradle).
         GMS-free flavors (fdroid/pro, src/noAds) never merge these, so their
         final manifests carry no ad-SDK references. -->
    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <meta-data
            android:name="librera.ADMOB_BANNER_ID"
            android:value="${admobBannerId}" />
        <meta-data
            android:name="librera.ADMOB_FULLSCREEN_ID"
            android:value="${admobFullId}" />
        <meta-data
            android:name="librera.ADMOB_REWARD"
            android:value="${admobRewardId}" />
    </application>

</manifest>
