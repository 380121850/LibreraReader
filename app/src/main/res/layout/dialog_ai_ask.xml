<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dip"
        android:background="@color/tint_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/aiAskBack"
            android:layout_width="48dip"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dip"
            android:src="@drawable/glyphicons_213_arrow_left"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/aiAskTitle"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/ai_ask_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dip">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_ask_text_hint"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/aiAskText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="8"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:text="@string/ai_ask_question_hint"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/aiAskQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aiAskSend"
                    android:layout_width="wrap_content"
                    android:layout_height="44dip"
                    android:layout_marginTop="2dip"
                    android:background="@drawable/bg_border_ltgray"
                    android:gravity="center"
                    android:minWidth="140dip"
                    android:paddingLeft="20dip"
                    android:paddingRight="20dip"
                    android:text="@string/ai_ask_send"
                    android:textColor="@color/tint_gray"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aiAskSaveNote"
                    android:layout_width="wrap_content"
                    android:layout_height="44dip"
                    android:layout_marginTop="6dip"
                    android:background="@drawable/bg_border_ltgray"
                    android:gravity="center"
                    android:minWidth="140dip"
                    android:paddingLeft="20dip"
                    android:paddingRight="20dip"
                    android:text="@string/save_as_note"
                    android:textColor="@color/tint_gray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dip"
                android:text="@string/ai_ask_answer"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aiAskResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dip"
                android:lineSpacingMultiplier="1.25"
                android:padding="4dip"
                android:textIsSelectable="true"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.foobnix.pdf.info.view.MyProgressBar
        android:id="@+id/aiAskProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dip"
        android:visibility="gone" />

</LinearLayout>
