<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom "about" block of the preferences page: version header, Librera pro
     link, changelog, licence, support mail, web, rate. Shared by the 偏好 tab
     (fragment_preferences.xml) and the 软件说明 drawer dialog (dialog_about.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/section6"
        style="@style/textLinkWhite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dip"
        android:background="@drawable/bg_search_second"
        android:text="Product: Lirbi Free" />

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="left|center_vertical"
        android:orientation="horizontal"
        android:padding="4dip"
        android:visibility="visible">

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="@dimen/wh_button"
            android:layout_height="@dimen/wh_button"
            android:layout_margin="4dip"
            android:src="@mipmap/icon_pdf_pro"
            android:tag="@string/no_tint" />

        <TextView
            android:id="@+id/downloadPRO"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="2dp"
            android:singleLine="false"
            android:text="@string/librera_pro" />
    </LinearLayout>


    <TextView
        android:id="@+id/pVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dip"
        android:text="Version: 1.2.3"
        android:visibility="gone" />


    <TextView
        android:id="@+id/whatIsNew"
        style="@style/textLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dip"
        android:padding="0dp"
        android:singleLine="true"
        android:text="@string/what_is_new_in" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dip"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/licence_gnu_gpl_v3_0" />

        <TextView
            android:id="@+id/libraryLicenses"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dip"
            android:text="@string/licenses_for_libraries" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dip"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autor_ivan_ivanenko" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dip"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:paddingLeft="5dip"
            android:text="@string/support" />

        <TextView
            android:id="@+id/onMailSupport"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_email" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:paddingLeft="5dip"
            android:text="@string/web" />

        <TextView
            android:id="@+id/openWeb"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://librera.mobi" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:paddingLeft="5dip"
            android:text="@string/beta_version" />

        <TextView
            android:id="@+id/openBeta"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://beta.librera.mobi" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:paddingLeft="5dip"
            android:text="FAQ" />

        <TextView
            android:id="@+id/openWiki"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://librera.mobi/faq" />
    </LinearLayout>

    <TextView
        android:id="@+id/onTelegram"
        style="@style/textLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/telegram_channel"
        android:visibility="gone" />


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="left|center_vertical"
        android:orientation="horizontal"
        android:padding="4dip"
        android:visibility="visible">

        <ImageView
            android:layout_width="@dimen/wh_button"
            android:layout_height="@dimen/wh_button"
            android:layout_margin="4dip"
            android:src="@drawable/glyphicons_13_heart"
            app:tint="@color/tint_gray" />

        <TextView
            android:id="@+id/onRateIt"
            style="@style/textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="2dip"
            android:singleLine="false"
            android:text="@string/rate_pdf_reader1" />
    </LinearLayout>

</LinearLayout>
