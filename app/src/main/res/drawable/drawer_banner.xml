<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="280dp"
    android:height="170dp"
    android:viewportWidth="280"
    android:viewportHeight="170">

    <!-- night sky gradient -->
    <path android:pathData="M0,0 h280 v170 h-280 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#46537a"
                android:centerColor="#333e60"
                android:endColor="#222b46"
                android:angle="270"/>
        </aapt:attr>
    </path>

    <!-- stars -->
    <path
        android:fillColor="#ffffff"
        android:fillAlpha="0.85"
        android:pathData="M34,38 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 z
            M64,96 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 z
            M96,30 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 z
            M128,70 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0 z
            M48,132 m-1.3,0 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 z
            M252,36 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 z
            M244,128 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 z
            M236,84 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 z
            M150,22 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 z
            M18,74 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 z"/>

    <!-- crescent moon: big disc with a sky-colored disc carved out -->
    <path
        android:fillColor="#f6e7b8"
        android:pathData="M190,75 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0 z"/>
    <path
        android:fillColor="#3a466c"
        android:pathData="M205,60 m-37,0 a37,37 0 1,0 74,0 a37,37 0 1,0 -74,0 z"/>

</vector>
